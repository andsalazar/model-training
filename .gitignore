# Secrets — never commit. Use `doppler run --` to inject at runtime.
.env
.env.*
*.pem

# Model weights and checkpoints
models/
ckpts/
checkpoints/
*.safetensors
*.bin
*.pt
*.pth

# Run artifacts
runs/
wandb/
outputs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Run evidence. The JSON behind the tables in docs/ is tracked so the numbers can be
# checked; adapters, clips and logs are not. The three largest raw captures (6.6 MB)
# stay local: their summaries (projection_*.json) are tracked.
artifacts/**
!artifacts/**/
!artifacts/**/*.json
# Stage 8's networks are small (97 KB each) and are the thing being read.
!artifacts/stage8_reading/networks/*.npz
artifacts/stage6_pod2/direction_audio_v2.json
artifacts/stage6_pod2/direction_video_v2.json
artifacts/stage6_pod2/direction_audio_full.json
